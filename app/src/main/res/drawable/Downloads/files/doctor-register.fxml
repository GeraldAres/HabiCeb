<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="register.doctorRegisterController"
           style="-fx-background-color: rgba(0,0,0,0.3);">

    <!-- CARD -->
    <VBox fx:id="card"
          alignment="CENTER"
          spacing="20"
          prefWidth="820"
          style="-fx-background-color: white;
                 -fx-padding: 35 60 35 60;
                 -fx-background-radius: 15;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20,0,0,5);">

        <!-- TITLE -->
        <VBox alignment="CENTER" spacing="4">
            <Label text="Create an Account"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;" />
            <TextFlow textAlignment="CENTER">
                <Text text="You are registering as a "
                      style="-fx-font-size: 13px;" />
                <Text text="Doctor."
                      style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-fill: #761E2A;" />
            </TextFlow>
        </VBox>

        <!-- FORM -->
        <GridPane hgap="20" vgap="16" alignment="CENTER">

            <columnConstraints>
                <!-- Left label -->
                <ColumnConstraints prefWidth="100" minWidth="100" halignment="RIGHT"/>
                <!-- Left field -->
                <ColumnConstraints prefWidth="260" minWidth="260" maxWidth="260"/>
                <!-- Right label -->
                <ColumnConstraints prefWidth="130" minWidth="130" halignment="RIGHT"/>
                <!-- Right field -->
                <ColumnConstraints prefWidth="260" minWidth="260" maxWidth="260"/>
            </columnConstraints>

            <!-- Row 0: Doctor ID | Birthdate -->
            <Label text="Doctor ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                   style="-fx-font-size: 13px;"/>
            <TextField fx:id="doctorIdField"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"
                       prefWidth="260" maxWidth="260"
                       style="-fx-background-color: #111; -fx-text-fill: white;
                              -fx-background-radius: 6; -fx-padding: 8 12; -fx-font-size: 13px;"/>

            <Label text="Birthdate:" GridPane.rowIndex="0" GridPane.columnIndex="2"
                   style="-fx-font-size: 13px;"/>
            <DatePicker fx:id="birthdatePicker"
                        GridPane.rowIndex="0" GridPane.columnIndex="3"
                        prefWidth="260" maxWidth="260"/>

            <!-- Row 1: Name | Password -->
            <Label text="Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                   style="-fx-font-size: 13px;"/>
            <TextField fx:id="nameField"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"
                       prefWidth="260" maxWidth="260"
                       style="-fx-background-color: #111; -fx-text-fill: white;
                              -fx-background-radius: 6; -fx-padding: 8 12; -fx-font-size: 13px;"/>

            <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="2"
                   style="-fx-font-size: 13px;"/>
            <PasswordField fx:id="passwordField"
                           GridPane.rowIndex="1" GridPane.columnIndex="3"
                           prefWidth="260" maxWidth="260"
                           style="-fx-background-color: #111; -fx-text-fill: white;
                                  -fx-background-radius: 6; -fx-padding: 8 12; -fx-font-size: 13px;"/>

            <!-- Row 2: Email | Confirm Password -->
            <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"
                   style="-fx-font-size: 13px;"/>
            <TextField fx:id="emailField"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"
                       prefWidth="260" maxWidth="260"
                       style="-fx-background-color: #111; -fx-text-fill: white;
                              -fx-background-radius: 6; -fx-padding: 8 12; -fx-font-size: 13px;"/>

            <Label text="Confirm&#10;Password:" GridPane.rowIndex="2" GridPane.columnIndex="2"
                   style="-fx-font-size: 13px;" wrapText="true"/>
            <PasswordField fx:id="confirmPasswordField"
                           GridPane.rowIndex="2" GridPane.columnIndex="3"
                           prefWidth="260" maxWidth="260"
                           style="-fx-background-color: #111; -fx-text-fill: white;
                                  -fx-background-radius: 6; -fx-padding: 8 12; -fx-font-size: 13px;"/>

            <!-- Row 3: Contact No | Gender -->
            <Label text="Contact&#10;No:" GridPane.rowIndex="3" GridPane.columnIndex="0"
                   style="-fx-font-size: 13px;" wrapText="true"/>
            <TextField fx:id="contactField"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"
                       prefWidth="260" maxWidth="260"
                       style="-fx-background-color: #111; -fx-text-fill: white;
                              -fx-background-radius: 6; -fx-padding: 8 12; -fx-font-size: 13px;"/>

            <Label text="Gender:" GridPane.rowIndex="3" GridPane.columnIndex="2"
                   style="-fx-font-size: 13px;"/>
            <!-- minWidth set programmatically in controller to avoid FXML constant issue -->
            <HBox fx:id="genderBox" spacing="30" alignment="CENTER_LEFT"
                  prefWidth="260" minWidth="260"
                  GridPane.rowIndex="3" GridPane.columnIndex="3">
                <RadioButton fx:id="maleBtn" text="Male"
                             style="-fx-font-size: 13px;"/>
                <RadioButton fx:id="femaleBtn" text="Female"
                             style="-fx-font-size: 13px;"/>
            </HBox>

        </GridPane>

        <!-- SPACER -->
        <Region prefHeight="8"/>

        <!-- CREATE ACCOUNT BUTTON -->
        <Button fx:id="createAccountBtn"
                text="Create Account"
                onAction="#handleCreateAccount"
                style="-fx-background-color: #C0392B;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 25;
                       -fx-padding: 12 70;
                       -fx-cursor: hand;"/>

        <!-- LOGIN LINK -->
        <HBox alignment="CENTER" spacing="2">
            <Label text="have an account? " style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
            <Label text="Log-in instead"
                   onMouseClicked="#goToLogin"
                   style="-fx-font-size: 12px; -fx-text-fill: #8B0000;
                          -fx-font-weight: bold; -fx-underline: true; -fx-cursor: hand;"/>
        </HBox>

    </VBox>
</StackPane>
