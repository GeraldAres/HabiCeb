<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/premium_cream">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="serif"
                android:text="HabiCeb"
                android:textColor="@color/premium_brown"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Welcome back,"
                android:textColor="@color/premium_gray_dark"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvHomeUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SeraPicks"
                android:textColor="@color/premium_brown"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="4dp"
                android:text="Effortless outfits &amp; everyday moments\nfinished with the vegan leather bag"
                android:textColor="@color/premium_gray_dark"
                android:textSize="13sp" />

            <androidx.cardview.widget.CardView
                style="@style/PremiumCard"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="32dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/model_bag" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#1A000000" />
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnShopNow"
                style="@style/PremiumButton"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:text="Shop the Collection" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="40dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Capsule Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:background="@drawable/nav_bar_bg"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/navHome"
            android:layout_width="100dp"
            android:layout_height="56dp"
            android:background="@drawable/nav_item_selected_bg"
            android:contentDescription="Home"
            android:src="@drawable/house_icon"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/navProfile"
            android:layout_width="100dp"
            android:layout_height="56dp"
            android:background="@android:color/transparent"
            android:contentDescription="Profile"
            android:src="@drawable/person_icon"
            app:tint="@color/white" />
    </LinearLayout>

</RelativeLayout>